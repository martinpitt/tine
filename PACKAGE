load("//platforms:cfg.bzl", "stage0", "stage1")
load("@prelude//cfg/modifier:common.bzl", "MODIFIER_METADATA_KEY")
load("@prelude//cfg/modifier:set_cfg_modifiers.bzl", "set_cfg_modifiers")
load("@prelude//platforms:defs.bzl", "host_configuration")

native.set_cfg_constructor(
    stage0 = stage0,
    stage1 = stage1,
    key = MODIFIER_METADATA_KEY,
    aliases = struct(),
    extra_data = struct(),
)

# A checkout can default to one distribution in its `.buckconfig.local`.
distribution = read_config("tine", "distribution")

set_cfg_modifiers([host_configuration.cpu, host_configuration.os] + ([distribution] if distribution else []))
